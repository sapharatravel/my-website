/>\\u003cpath d=\"M9 7V5.5A1.5 1.5 0 0 1 10.5 4h3A1.5 1.5 0 0 1 15 5.5V7M3 12.5h18\"/>","something-else":"\\u003cpath d=\"M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z\"/>\\u003cpath d=\"M7 9h10M7 12h6\"/>","guides":"\\u003cpath d=\"M5 21V4\"/>\\u003cpath d=\"M5 4h11l-2 3.5L16 11H5\"/>","excursions":"\\u003ccircle cx=\"12\" cy=\"12\" r=\"9\"/>\\u003cpath d=\"m15.5 8.5-2 5-5 2 2-5z\"/>","mosque":"\\u003cpath d=\"M3 20h18M5 20v-7h14v7M4 13c0-4.5 3.6-7 8-9 4.4 2 8 4.5 8 9\"/>\\u003cpath d=\"M10 20v-4a2 2 0 0 1 4 0v4M12 4V2\"/>","halal":"\\u003ccircle cx=\"12\" cy=\"12\" r=\"9\"/>\\u003cpath d=\"m7.5 12 3 3 6-6\"/>","alcohol-free":"\\u003cpath d=\"M8 3h8l-1 7-2 2v8M11 20h4M7 3l10 18\"/>","private-pool":"\\u003cpath d=\"M8 15V6a2 2 0 0 1 4 0M14 15V6a2 2 0 0 1 4 0\"/>\\u003cpath d=\"M8 9h6M8 12.5h6\"/>\\u003cpath d=\"M3 19c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0\"/>","beachfront":"\\u003cpath d=\"M4 11a8 8 0 0 1 16 0z\"/>\\u003cpath d=\"M12 11v8\"/>\\u003cpath d=\"M3 21c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0\"/>","city":"\\u003cpath d=\"M3 21h18M5 21V9h5v12M10 21V4h5v17M15 21v-9h4v9\"/>\\u003cpath d=\"M7 12h1M7 15h1M12 8h1M12 11h1M12 14h1M17 15h1\"/>","mountain":"\\u003cpath d=\"m2 20 7-13 4 7 3-5 6 11H2z\"/>\\u003cpath d=\"m7 11 2 2 2-1M14 12l2 2 2-1\"/>","solo":"\\u003ccircle cx=\"12\" cy=\"7\" r=\"3.5\"/>\\u003cpath d=\"M5 21v-2a7 7 0 0 1 14 0v2\"/>","luxury":"\\u003cpath d=\"m12 2 1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8z\"/>\\u003cpath d=\"m19 16 .9 2.1L22 19l-2.1.9L19 22l-.9-2.1L16 19l2.1-.9z\"/>","spa":"\\u003cpath d=\"M12 21c-5-2-8-6-8-11 5 0 8 3 8 8 0-5 3-8 8-8 0 5-3 9-8 11z\"/>\\u003cpath d=\"M12 18V8\"/>","breakfast":"\\u003cpath d=\"M6.5 3v5.5a2.5 2.5 0 0 0 5 0V3M9 3v18\"/>\\u003cpath d=\"M17.5 21V3c-2 1.5-3 4-3 7.5V13h3\"/>","car":"\\u003cpath d=\"M5 11l1.6-4.2A1.5 1.5 0 0 1 8 6h8a1.5 1.5 0 0 1 1.4.8L19 11\"/>\\u003crect x=\"3\" y=\"11\" width=\"18\" height=\"6\" rx=\"1.5\"/>\\u003cpath d=\"M6 17v2M1