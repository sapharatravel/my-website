---
// Every page: head and metadata, header and phone menu, Instagram strip, footer, sticky bar and the shared script.
import { assetV, Page, header, footer, sticky, igStrip, esc, keepWhatsAppTogether, keepTogether, PROTOTYPE, C, cleanLinks, waLinks, travelAgencyLd, websiteLd, breadcrumbLd, ldScript, responsiveImgs } from "../lib/site.js";

interface Props { path: string; title: string; desc: string; og?: string; hero?: boolean; ld?: object | null }
const { path, title, og = "og-home.jpg", hero = false, ld = null } = Astro.props;
const pg = new Page(path);
const desc = C.DESC_OVERRIDES[path] ?? Astro.props.desc;
const noindex = PROTOTYPE || path === "404.html" || path === "thank-you.html";
// Clean URLs: Cloudflare serves privacy.html at /privacy and guides/index.html at /guides/, so the canonical matches what people see.
const canon = "https://sapharatravel.co.uk/" + path.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
// Internal links go straight to the clean addresses (no redirect through .html), see cleanLinks in site.js.
// WhatsApp buttons get the page's own opener and tag (waLinks in site.js).
// Photos get srcset and sizes from src/data/img-sizes.json (responsiveImgs in site.js, 21 Nov 2026).
const tidy = (html) => responsiveImgs(waLinks(cleanLinks(keepTogether(html), path), path));
const body = responsiveImgs(waLinks(cleanLinks(keepWhatsAppTogether(await Astro.slots.render("default")), path), path));
// Structured data: TravelAgency and WebSite on the homepage, BreadcrumbList from the visible breadcrumb, plus any page extra (Article on guides).
const isHome = path === "index.html";
const ldHtml = noindex ? "" : ldScript([isHome && travelAgencyLd(), isHome && websiteLd(), breadcrumbLd(body, path, canon), ld]);
// The Plan my trip form (Concept C, 22 Nov 2026) loads its own styles and script, only on pages that have it.
const planForm = body.includes('id="planForm"');
const bodyClass = (hero ? "has-hero" : "no-hero") + (path === "index.html" ? " home" : "");
const head = `<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>${esc(title)}</title>
<meta name="description" content="${esc(desc)}">
${noindex ? '<meta name="robots" content="noindex, nofollow">\n' : ""}
<link rel="canonical" href="${canon}">
<meta name="theme-color" content="#F5EFE4">
<link rel="icon" href="${pg.img("icons/favicon.svg")}" type="image/svg+xml">
<link rel="apple-touch-icon" href="${pg.img("icons/apple-touch-icon.png")}">
<meta property="og:type" content="website"><meta property="og:site_name" content="Saphara Travel">
<meta property="og:title" content="${esc(title)}"><meta property="og:description" content="${esc(desc)}">
<meta property="og:url" content="${canon}"><meta property="og:image" content="https://sapharatravel.co.uk/img/${og}">
<meta property="og:locale" content="en_GB"><meta name="twitter:card" content="summary_large_image">
<link rel="preload" as="font" type="font/woff2" href="${pg.u("assets/fonts/inter-400-latin.woff2")}" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="${pg.u("assets/fonts/inter-500-latin.woff2")}" crossorigin>
<link rel="preconnect" href="https://use.typekit.net" crossorigin>
<link rel="stylesheet" href="https://use.typekit.net/swo1kcy.css" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="https://use.typekit.net/swo1kcy.css"></noscript>
<link rel="stylesheet" href="${pg.u("assets/site.css")}?v=${assetV("site.css")}">${planForm ? `\n<link rel="preload" as="style" href="${pg.u("assets/plan-form.css")}?v=${assetV("plan-form.css")}"><link rel="stylesheet" href="${pg.u("assets/plan-form.css")}?v=${assetV("plan-form.css")}" media="print" onload="this.media=String.fromCharCode(97,108,108)"><noscript><link rel="stylesheet" href="${pg.u("assets/plan-form.css")}?v=${assetV("plan-form.css")}"></noscript>` : ""}${ldHtml ? "\n" + ldHtml : ""}`;
---
<html lang="en-GB">
<head>
<Fragment set:html={head} />
</head>
<body class={bodyClass}>
<div class="scroll-progress" id="progress" aria-hidden="true"></div>
<Fragment set:html={tidy(header(pg))} />
<main id="main" tabindex="-1">
<Fragment set:html={body} />
</main>
<Fragment set:html={path === "index.html" ? "" : tidy(igStrip(pg))} />
<Fragment set:html={tidy(footer(pg))} />
<Fragment set:html={tidy(sticky(pg))} />
<script is:inline>window.SAPHARA_ICONS = {"hotel":"\\u003cpath d=\"M3 6v14\"/>\\u003cpath d=\"M3 15h18v5\"/>\\u003cpath d=\"M21 15v-2a3 3 0 0 0-3-3h-7v5\"/>\\u003ccircle cx=\"7\" cy=\"12\" r=\"1.8\"/>","chat":"\\u003cpath d=\"M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-4 3v-3H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z\"/>\\u003cpath d=\"M7 9h10M7 12h6\"/>","flights":"\\u003cpath d=\"M2.5 13.5 10 11V5.5a2 2 0 0 1 4 0V11l7.5 2.5V15L14 13.5V18l2 1.5V21l-4-1-4 1v-1.5L10 18v-4.5L2.5 15z\"/>","heart":"\\u003ccircle cx=\"9\" cy=\"14\" r=\"5\"/>\\u003ccircle cx=\"15\" cy=\"14\" r=\"5\"/>\\u003cpath d=\"M10.5 5.5 12 4l1.5 1.5L12 7z\"/>","transfers":"\\u003cpath d=\"M5 11l1.6-4.2A1.5 1.5 0 0 1 8 6h8a1.5 1.5 0 0 1 1.4.8L19 11\"/>\\u003crect x=\"3\" y=\"11\" width=\"18\" height=\"6\" rx=\"1.5\"/>\\u003cpath d=\"M6 17v2M18 17v2\"/>","map":"\\u003cpath d=\"M5 21V4\"/>\\u003cpath d=\"M5 4h11l-2 3.5L16 11H5\"/>","beach":"\\u003cpath d=\"M4 11a8 8 0 0 1 16 0z\"/>\\u003cpath d=\"M12 11v8\"/>\\u003cpath d=\"M3 21c1.5-1 3-1 4.5 0s3 1 4.5 0 3-1 4.5 0 3 1 4.5 0\"/>","family":"\\u003ccircle cx=\"6.5\" cy=\"6.5\" r=\"2.5\"/>\\u003cpath d=\"M3 20v-5a3.5 3.5 0 0 1 7 0v5\"/>\\u003ccircle cx=\"14\" cy=\"6.5\" r=\"2.5\"/>\\u003cpath d=\"M10.5 20v-5a3.5 3.5 0 0 1 7 0v5\"/>\\u003ccircle cx=\"20\" cy=\"11.5\" r=\"1.6\"/>\\u003cpath d=\"M18 20v-3a2 2 0 0 1 4 0v3\"/>","people":"\\u003ccircle cx=\"9\" cy=\"8\" r=\"3\"/>\\u003cpath d=\"M3.5 20a5.5 5.5 0 0 1 11 0\"/>\\u003cpath d=\"M15 4.5h5.5a1 1 0 0 1 1 1V9a1 1 0 0 1-1 1H18l-2 1.6V10h-1a1 1 0 0 1-1-1V5.5a1 1 0 0 1 1-1z\"/>","fee":"\\u003cpath d=\"M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z\"/>\\u003ccircle cx=\"7.5\" cy=\"7.5\" r=\"1.4\"/>\\u003cpath d=\"M10 16l6-6\"/>","paylater":"\\u003crect x=\"3\" y=\"5\" width=\"13\" height=\"13\" rx=\"2\"/>\\u003cpath d=\"M3 9.5h13M7 3v4M12 3v4\"/>\\u003ccircle cx=\"17\" cy=\"16.5\" r=\"4.5\"/>\\u003cpath d=\"M17 14.5v2.2l1.4 1\"/>","shield":"\\u003cpath d=\"M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6z\"/>\\u003cpath d=\"m9 12 2