---
import Base from "../../layouts/Base.astro";
import { tripPage } from "../../lib/pages.js";
import { C } from "../../lib/site.js";
export function getStaticPaths() { return Object.keys(C.TRIP_PAGES).map((slug) => ({ params: { slug } })); }
const p = tripPage(Astro.params.slug);
---
<Base path={p.path} title={p.title} desc={p.desc} hero={p.hero} og={p.og}><Fragment set:html={p.body} /></Base>
